FROM golang:1.24-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/mimic-mcp ./cmd/mimic-mcp

FROM alpine:3.19
WORKDIR /app
COPY --from=builder /app/mimic-mcp /usr/local/bin/mimic-mcp

# MCP server communicates via stdio
ENTRYPOINT ["/usr/local/bin/mimic-mcp", "--stdio"]
