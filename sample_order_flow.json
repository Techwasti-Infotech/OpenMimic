{   "id": "order-flow-template",   "name": "E-Commerce Order Flow",   "eventLimit": "1000",   "sink": {     "stdout": {       "pretty": true     }   },   "fields": [     {       "name": "order_id",       "generator": {         "uuid": {}       }     },     {       "name": "customer_id",       "generator": {         "entityPool": {           "poolSize": 100,           "entityPrefix": "usr_"         }       }     },     {       "name": "amount",       "generator": {         "distribution": {           "normal": {             "mean": 75,             "stdDev": 20           }         }       }     },     {       "name": "status",       "generator": {         "weightedChoice": {           "options": [             {               "value": "COMPLETED",               "weight": 95             },             {               "value": "FAILED",               "weight": 5             }           ]         }       }     },     {       "name": "timestamp",       "generator": {         "now": {           "format": "RFC3339"         }       }     }   ] }